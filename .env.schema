# KolShek environment configuration
# see https://varlock.dev/env-spec for @env-spec syntax
#
# @defaultRequired=false @defaultSensitive=false
# ----------

# JSON object mapping provider aliases to credential objects
# e.g. {"leumi":{"username":"...","password":"..."}}
# @sensitive
KOLSHEK_CREDENTIALS_JSON=

# Path to Chrome/Chromium binary (auto-detected if not set)
KOLSHEK_CHROME_PATH=

# Max concurrent scraper instances (default: 1)
# @type=number
KOLSHEK_CONCURRENCY=

# Override data directory (default: OS standard path)
KOLSHEK_DATA_DIR=

# OTP code for providers that require 2FA
# @sensitive
KOLSHEK_OTP=

# Run Chrome with --no-sandbox (needed in some containers)
# @type=boolean
KOLSHEK_NO_SANDBOX=

# Dev mode — set to 1 only when running the Vite dev server (bun run dev:web).
# Adds http://localhost:5173 to the dashboard's trusted origins and writes the
# session token to .dev-session for the Vite proxy. Do NOT set this in normal
# use: :5173 is same-site with the dashboard, so trusting it lets any local
# process that binds that port drive the dashboard without the session token.
KOLSHEK_DEV=
